APP_NAME="Hamster AI Agents"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=hamster
DB_USERNAME=hamster
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend (Next.js) y sesión por cookie de Sanctum
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000


# Proxies de confianza (IPs separadas por coma, o *). En local, Next.js corre en la misma máquina.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Proveedores de IA ---------------------------------------------------------------------------
# Chat: mock | anthropic        Embeddings: mock | openai
AI_PROVIDER=mock
AI_EMBEDDINGS_PROVIDER=mock

ANTHROPIC_API_KEY=
# Opus 5.5 es el más capaz y el más caro; para bajar el costo por mensaje prueba claude-sonnet-5-5 o claude-haiku-4-5.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low

OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Al cambiar de proveedor de embeddings: php artisan knowledge:reindex

# --- Facturación (Stripe) y planes ---------------------------------------------------------------
# Sin STRIPE_SECRET la app funciona (pruebas, planes por cortesía desde /admin); solo se desactiva el cobro.
STRIPE_SECRET=
# Secreto de firma del endpoint de webhooks (POST /api/webhooks/stripe, directo a Laravel, no vía Next).
STRIPE_WEBHOOK_SECRET=
# Los Price ID de cada plan se guardan en la tabla plans (editables en /admin/plans), no aquí.
BILLING_TRIAL_DAYS=14
BILLING_TRIAL_PLAN=starter
# Con un cobro fallido (past_due) el servicio sigue mientras Stripe reintenta.
BILLING_PAST_DUE_KEEPS_SERVICE=true
# Costo mensual de infraestructura en USD, para el margen del panel de plataforma.
PLATFORM_INFRA_COST_USD=0
# Avisos de fin de prueba: días de antelación (el comando billing:lifecycle corre a diario, ver routes/console.php).
BILLING_TRIAL_ENDING_DAYS=3

# --- Equipo -------------------------------------------------------------------------------------
# Días de validez de una invitación y tope de invitaciones (nuevas o reenviadas) por empresa y hora.
TEAM_INVITATION_DAYS=7
TEAM_INVITATIONS_PER_HOUR=30
